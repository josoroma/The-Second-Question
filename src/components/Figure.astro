---
// A book figure (art/SKILL.md). The server renders its designed still as an
// inline SVG, so it reads without JavaScript; the client then runs its loop,
// lets it answer the pointer, and can turn it into a 3D scene.
import { strings, type Lang } from "@/data/ui"
import { renderToString } from "@/lib/iso/svg.js"

interface Props {
  /** Figures to try in order: the first one that exists is drawn. */
  slugs: string[]
  /** Needed only when the same figure appears twice on one page. */
  idSuffix?: string
  class?: string
  /** "3d" starts in the 3D view when the browser allows it. */
  mode?: "2d" | "3d"
  /** Plate, read-out and the 3D buttons. */
  controls?: boolean
  /** The name on the plate. Defaults to the figure's own. */
  plate?: string
  /** Number shown before the plate name, e.g. "19". */
  number?: string
  /** Load priority: the hero figure is eager. */
  eager?: boolean
  lang?: Lang
}

const { slugs, idSuffix, class: className, mode = "2d", controls = false, plate, number, lang = "en" } = Astro.props
const t = strings(lang)
const figures = import.meta.glob("/src/figures/*.js", { eager: true }) as Record<string, { default: any }>
const slug = slugs.find((s) => figures[`/src/figures/${s}.js`])
const fig = slug ? figures[`/src/figures/${slug}.js`].default : null
const prefix = `iso-${slug}${idSuffix ? `-${idSuffix}` : ""}`
const plateName = plate ?? fig?.plate ?? ""
// The figures are titled and described in English; the Spanish pages name them by their plate.
const words = lang === "en" ? {} : { title: `${t.illustration}: ${plateName}`, desc: "" }
const svg = fig ? renderToString(fig, { prefix, ...words }) : null
---

{
  fig && svg ? (
    <figure class:list={["iso-figure", className]} data-slug={slug} data-mode={mode} data-prefix={prefix} data-view="2d">
      <div class="iso-stage iso" set:html={svg} />
      {controls && (
        <>
          <div class="iso-tools" role="group" aria-label={t.figureView}>
            <button type="button" data-act="3d" aria-pressed="false" title={t.view3d}>
              3D
            </button>
            <button type="button" data-act="revolve" aria-pressed="false" title={t.revolveTitle}>
              {t.revolve}
            </button>
            <button type="button" data-act="iso" title={t.isoTitle}>
              {t.isoView}
            </button>
          </div>
          <figcaption class="iso-bar">
            <span class="iso-plate">
              <i aria-hidden="true" />
              {number && <span class="iso-num">{number}</span>}
              {plateName}
            </span>
            {lang === "en" && (
              <span class="iso-readout" aria-live="polite">
                rest
              </span>
            )}
          </figcaption>
        </>
      )}
    </figure>
  ) : (
    <figure class:list={["iso-figure iso-missing", className]} aria-hidden="true">
      <div class="iso-stage iso" />
    </figure>
  )
}

<script>
  import { hydrateFigures } from "@/lib/iso/hydrate.js"
  hydrateFigures()
</script>
